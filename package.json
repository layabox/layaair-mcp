{
  "name": "layaair-mcp-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "typecheck": "node scripts/check-types.mjs && npm --prefix assets/layaair-mcp/server-src~ run typecheck",
    "build": "layaair export-installable-package assets/layaair-mcp -o dist/layaair-mcp.layapkg",
    "test": "node --test scripts/smoke.test.mjs",
    "build:runtime": "npm --prefix assets/layaair-mcp/server-src~ run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "22.20.1",
    "esbuild": "0.27.1",
    "express": "4.22.2",
    "typescript": "5.9.3"
  }
}
