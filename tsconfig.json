{
  "compilerOptions": {
    "module": "es2022",
    "target": "es2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "strictNullChecks": false,
    "noEmit": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "paths": {
      "~/packages/*": [
        "./library/packages/*"
      ]
    }
  },
  "include": [
    "assets/**/*.ts",
    "src/**/*.ts",
    "engine/types/*.d.ts"
  ],
  "exclude": [
    "assets/layaair-mcp/server-src~"
  ]
}
